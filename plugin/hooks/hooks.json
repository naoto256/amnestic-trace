{
  "description": "AMT PreCompact capture + turn-start injection of the replacement memory.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/tools/amt-hook.sh\" precompact",
            "statusMessage": "AMT: capturing working memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/tools/amt-hook.sh\" recall",
            "statusMessage": "AMT: restoring working memory"
          }
        ]
      }
    ]
  }
}
